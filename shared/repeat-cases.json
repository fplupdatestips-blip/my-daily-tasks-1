{
  "about": "Shared test cases for the repeat-rule engine. Both web/src/core/repeat.test.ts and android/app/src/test/.../RepeatEngineTest.kt run every case here, so the phone and the web always agree on what is due. Dates are local calendar dates. 2026-11-20 is a Friday. weekStart 1 = Monday.",
  "weekStart": 1,
  "dueCases": [
    { "name": "daily is due every day", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-01" }, "date": "2026-11-20", "expect": { "due": true } },
    { "name": "daily is not due before its start date", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-21" }, "date": "2026-11-20", "expect": { "due": false } },
    { "name": "every 3 days lands on anchor plus 6", "repeat": { "type": "DAILY", "interval": 3, "startDate": "2026-11-14" }, "date": "2026-11-20", "expect": { "due": true } },
    { "name": "every 3 days skips anchor plus 7", "repeat": { "type": "DAILY", "interval": 3, "startDate": "2026-11-14" }, "date": "2026-11-21", "expect": { "due": false } },
    { "name": "Mon Wed Fri is due on Friday", "repeat": { "type": "WEEKLY", "daysOfWeek": [1, 3, 5], "startDate": "2026-11-01" }, "date": "2026-11-20", "expect": { "due": true } },
    { "name": "Mon Wed Fri is not due on Saturday", "repeat": { "type": "WEEKLY", "daysOfWeek": [1, 3, 5], "startDate": "2026-11-01" }, "date": "2026-11-21", "expect": { "due": false } },
    { "name": "monthly on the 31st falls back to 30 Nov", "repeat": { "type": "MONTHLY", "dayOfMonth": 31, "startDate": "2026-01-01" }, "date": "2026-11-30", "expect": { "due": true } },
    { "name": "monthly on the 31st is not due on 29 Nov", "repeat": { "type": "MONTHLY", "dayOfMonth": 31, "startDate": "2026-01-01" }, "date": "2026-11-29", "expect": { "due": false } },
    { "name": "monthly on the 15th", "repeat": { "type": "MONTHLY", "dayOfMonth": 15, "startDate": "2026-01-01" }, "date": "2026-11-15", "expect": { "due": true } },
    { "name": "second Tuesday of November 2026 is the 10th", "repeat": { "type": "MONTHLY", "ordinal": 2, "weekday": 2, "startDate": "2026-01-01" }, "date": "2026-11-10", "expect": { "due": true } },
    { "name": "second Tuesday is not the 17th", "repeat": { "type": "MONTHLY", "ordinal": 2, "weekday": 2, "startDate": "2026-01-01" }, "date": "2026-11-17", "expect": { "due": false } },
    { "name": "last Friday of November 2026 is the 27th", "repeat": { "type": "MONTHLY", "ordinal": -1, "weekday": 5, "startDate": "2026-01-01" }, "date": "2026-11-27", "expect": { "due": true } },
    { "name": "last Friday is not the 20th", "repeat": { "type": "MONTHLY", "ordinal": -1, "weekday": 5, "startDate": "2026-01-01" }, "date": "2026-11-20", "expect": { "due": false } },
    { "name": "yearly 29 Feb falls back to 28 Feb in 2027", "repeat": { "type": "YEARLY", "month": 2, "dayOfMonth": 29, "startDate": "2026-01-01" }, "date": "2027-02-28", "expect": { "due": true } },
    { "name": "yearly 29 Feb is not 28 Feb in a leap year", "repeat": { "type": "YEARLY", "month": 2, "dayOfMonth": 29, "startDate": "2026-01-01" }, "date": "2028-02-28", "expect": { "due": false } },
    { "name": "yearly 29 Feb on 29 Feb 2028", "repeat": { "type": "YEARLY", "month": 2, "dayOfMonth": 29, "startDate": "2026-01-01" }, "date": "2028-02-29", "expect": { "due": true } },
    { "name": "3 times a week, 2 done, still due", "repeat": { "type": "QUOTA", "count": 3, "period": "WEEK", "startDate": "2026-11-01" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-16", "status": "DONE" }, { "date": "2026-11-17", "status": "DONE" } ], "expect": { "due": true } },
    { "name": "3 times a week, quota met, not due", "repeat": { "type": "QUOTA", "count": 3, "period": "WEEK", "startDate": "2026-11-01" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-16", "status": "DONE" }, { "date": "2026-11-17", "status": "DONE" }, { "date": "2026-11-18", "status": "DONE" } ], "expect": { "due": false } },
    { "name": "3 times a week, third done today still shows", "repeat": { "type": "QUOTA", "count": 3, "period": "WEEK", "startDate": "2026-11-01" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-16", "status": "DONE" }, { "date": "2026-11-17", "status": "DONE" }, { "date": "2026-11-20", "status": "DONE" } ], "expect": { "due": true } },
    { "name": "3 times a week, last week's ticks do not count", "repeat": { "type": "QUOTA", "count": 3, "period": "WEEK", "startDate": "2026-11-01" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-13", "status": "DONE" }, { "date": "2026-11-14", "status": "DONE" }, { "date": "2026-11-15", "status": "DONE" } ], "expect": { "due": true } },
    { "name": "twice a month, met", "repeat": { "type": "QUOTA", "count": 2, "period": "MONTH", "startDate": "2026-11-01" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-02", "status": "DONE" }, { "date": "2026-11-09", "status": "DONE" } ], "expect": { "due": false } },
    { "name": "7 days after last done, due exactly", "repeat": { "type": "AFTER_DONE", "interval": 7, "startDate": "2026-11-01" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-13", "status": "DONE" } ], "expect": { "due": true } },
    { "name": "7 days after last done, not yet", "repeat": { "type": "AFTER_DONE", "interval": 7, "startDate": "2026-11-01" }, "date": "2026-11-19",
      "completions": [ { "date": "2026-11-13", "status": "DONE" } ], "expect": { "due": false } },
    { "name": "7 days after last done, 3 days overdue", "repeat": { "type": "AFTER_DONE", "interval": 7, "startDate": "2026-11-01" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-10", "status": "DONE" } ], "expect": { "due": true, "overdueDays": 3 } },
    { "name": "after-done task never done is due from its start date", "repeat": { "type": "AFTER_DONE", "interval": 7, "startDate": "2026-11-18" }, "date": "2026-11-20",
      "expect": { "due": true, "overdueDays": 2 } },
    { "name": "after-done task done today still shows today", "repeat": { "type": "AFTER_DONE", "interval": 7, "startDate": "2026-11-01" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-12", "status": "DONE" }, { "date": "2026-11-20", "status": "DONE" } ], "expect": { "due": true, "overdueDays": 1 } },
    { "name": "one-off due today", "repeat": { "type": "NONE", "dueDate": "2026-11-20" }, "date": "2026-11-20", "expect": { "due": true } },
    { "name": "one-off not done yesterday moves to today", "repeat": { "type": "NONE", "dueDate": "2026-11-19" }, "date": "2026-11-20", "expect": { "due": true, "movedFrom": "2026-11-19", "overdueDays": 1 } },
    { "name": "one-off three days late", "repeat": { "type": "NONE", "dueDate": "2026-11-17" }, "date": "2026-11-20", "expect": { "due": true, "movedFrom": "2026-11-17", "overdueDays": 3 } },
    { "name": "one-off done yesterday is gone today", "repeat": { "type": "NONE", "dueDate": "2026-11-19" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-19", "status": "DONE" } ], "expect": { "due": false } },
    { "name": "one-off done today still shows today", "repeat": { "type": "NONE", "dueDate": "2026-11-18" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-20", "status": "DONE" } ], "expect": { "due": true, "movedFrom": "2026-11-18", "overdueDays": 2 } },
    { "name": "one-off is not shown before its due date", "repeat": { "type": "NONE", "dueDate": "2026-11-21" }, "date": "2026-11-20", "expect": { "due": false } },
    { "name": "one-off skipped yesterday does not roll over", "repeat": { "type": "NONE", "dueDate": "2026-11-19" }, "date": "2026-11-20",
      "completions": [ { "date": "2026-11-19", "status": "SKIPPED" } ], "expect": { "due": false } },
    { "name": "repeat ended yesterday", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-01", "endDate": "2026-11-19" }, "date": "2026-11-20", "expect": { "due": false } },
    { "name": "paused task is hidden", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-01" }, "pausedUntil": "2026-11-22", "date": "2026-11-20", "expect": { "due": false } },
    { "name": "pause ended yesterday", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-01" }, "pausedUntil": "2026-11-19", "date": "2026-11-20", "expect": { "due": true } },
    { "name": "archived task is hidden", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-01" }, "archived": true, "date": "2026-11-20", "expect": { "due": false } }
  ],
  "streakCases": [
    { "name": "four days in a row including today", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-01" }, "today": "2026-11-20",
      "completions": [ { "date": "2026-11-17", "status": "DONE" }, { "date": "2026-11-18", "status": "DONE" }, { "date": "2026-11-19", "status": "DONE" }, { "date": "2026-11-20", "status": "DONE" } ],
      "expect": { "current": 4, "best": 4 } },
    { "name": "today not done yet does not break the streak", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-01" }, "today": "2026-11-20",
      "completions": [ { "date": "2026-11-17", "status": "DONE" }, { "date": "2026-11-18", "status": "DONE" }, { "date": "2026-11-19", "status": "DONE" } ],
      "expect": { "current": 3, "best": 3 } },
    { "name": "a missed day breaks it, best is kept", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-01" }, "today": "2026-11-20",
      "completions": [ { "date": "2026-11-10", "status": "DONE" }, { "date": "2026-11-11", "status": "DONE" }, { "date": "2026-11-12", "status": "DONE" }, { "date": "2026-11-18", "status": "DONE" }, { "date": "2026-11-19", "status": "DONE" } ],
      "expect": { "current": 2, "best": 3 } },
    { "name": "Mon Wed Fri is not broken by the days in between", "repeat": { "type": "WEEKLY", "daysOfWeek": [1, 3, 5], "startDate": "2026-11-01" }, "today": "2026-11-20",
      "completions": [ { "date": "2026-11-11", "status": "DONE" }, { "date": "2026-11-13", "status": "DONE" }, { "date": "2026-11-16", "status": "DONE" }, { "date": "2026-11-18", "status": "DONE" } ],
      "expect": { "current": 4, "best": 4 } },
    { "name": "a skipped day is neutral", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-01" }, "today": "2026-11-20",
      "completions": [ { "date": "2026-11-17", "status": "DONE" }, { "date": "2026-11-18", "status": "SKIPPED" }, { "date": "2026-11-19", "status": "DONE" } ],
      "expect": { "current": 2, "best": 2 } },
    { "name": "nothing done yet", "repeat": { "type": "DAILY", "interval": 1, "startDate": "2026-11-15" }, "today": "2026-11-20",
      "expect": { "current": 0, "best": 0 } },
    { "name": "one-off tasks have no streak", "repeat": { "type": "NONE", "dueDate": "2026-11-19" }, "today": "2026-11-20",
      "completions": [ { "date": "2026-11-19", "status": "DONE" } ],
      "expect": { "current": 0, "best": 0 } }
  ]
}
